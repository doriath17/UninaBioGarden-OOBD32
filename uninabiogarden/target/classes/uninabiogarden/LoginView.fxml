<GridPane fx:id="contentPane" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="576.0" prefWidth="715.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uninabiogarden.ControllerLogIn">
